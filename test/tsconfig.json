{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["bun", "@webgpu/types"],
    "isolatedDeclarations": false
  },
  "include": [
    "../packages/core/**/*.ts",
    "../packages/react/**/*.ts",
    "../packages/react/**/*.tsx",
    "../scripts/**/*.ts",
    "./e2e/**/*.ts",
    "./fixtures/browser/**/*.ts",
    "./*.test.ts"
  ],
  "exclude": ["../packages/*/dist", "../node_modules"]
}
